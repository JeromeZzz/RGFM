    "# 分析注意力权重\n",
    "result_with_attention = predictor.predict(\n",
    "    graph,\n",
    "    ('users', 0),\n",
    "    prediction_time,\n",
    "    task_config,\n",
    "    return_attention=True\n",
    ")\n",
    "\n",
    "if 'attention_weights' in result_with_attention:\n",
    "    print(\"注意力权重分析:\")\n",
    "    for key, weights in result_with_attention['attention_weights'].items():\n",
    "        if isinstance(weights, torch.Tensor):\n",
    "            print(f\"  {key}: shape={weights.shape}\")\n",
    "        else:\n",
    "            print(f\"  {key}: {type(weights)}\")"
   ]
