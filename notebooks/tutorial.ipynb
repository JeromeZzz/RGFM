    "## 2. 数据准备"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 创建示例数据\n",
    "def create_sample_data():\n",
    "    # 用户数据\n",
    "    users_data = {\n",
    "        'user_id': range(100),\n",
    "        'age': np.random.randint(18, 65, 100),\n",
    "        'gender': np.random.choice(['M', 'F'], 100),\n",
    "        'city': np.random.choice(['北京', '上海', '广州', '深圳'], 100)\n",
    "    }\n",
    "    users_df = pd.DataFrame(users_data)\n",
    "    \n",
    "    # 商品数据\n",
    "    items_data = {\n",
    "        'item_id': range(200),\n",
    "        'category': np.random.choice(['电子', '服装', '食品', '图书'], 200),\n",
    "        'price': np.random.uniform(10, 1000, 200),\n",
    "        'brand': np.random.choice(['品牌A', '品牌B', '品牌C'], 200)\n",
    "    }\n",
    "    items_df = pd.DataFrame(items_data)\n",
    "    \n",
    "    # 交易数据\n",
    "    transactions = []\n",
    "    for _ in range(1000):\n",
    "        user_id = np.random.randint(0, 100)\n",
    "        item_id = np.random.randint(0, 200)\n",
    "        timestamp = datetime.now() - timedelta(days=np.random.randint(0, 365))\n",
    "        amount = items_df.loc[item_id, 'price'] * np.random.uniform(0.8, 1.2)\n",
    "        \n",
    "        transactions.append({\n",
    "            'user_id': user_id,\n",
    "            'item_id': item_id,\n",
    "            'timestamp': timestamp,\n",
    "            'amount': amount,\n",
    "            'rating': np.random.randint(1, 6)\n",
    "        })\n",
    "    \n",
    "    transactions_df = pd.DataFrame(transactions)\n",
    "    \n",
    "    return users_df, items_df, transactions_df\n",
    "\n",
    "# 创建数据\n",
    "users_df, items_df, transactions_df = create_sample_data()\n",
    "\n",
    "print(\"数据统计:\")\n",
    "print(f\"用户数: {len(users_df)}\")\n",
    "print(f\"商品数: {len(items_df)}\")\n",
    "print(f\"交易数: {len(transactions_df)}\")\n",
    "\n",
    "# 显示数据样本\n",
    "print(\"\\n用户数据样本:\")\n",
    "display(users_df.head())\n",
    "\n",
    "print(\"\\n交易数据样本:\")\n",
    "display(transactions_df.head())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 数据可视化\n",
    "fig, axes = plt.subplots(2, 2, figsize=(12, 8))\n",
    "\n",
    "# 用户年龄分布\n",
    "users_df['age'].hist(ax=axes[0, 0], bins=20)\n",
