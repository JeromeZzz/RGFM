    "axes[1, 0].set_xlabel('时间')\n",
    "\n",
    "# 用户交易频次\n",
    "user_freq = transactions_df['user_id'].value_counts()\n",
    "user_freq.hist(ax=axes[1, 1], bins=20)\n",
    "axes[1, 1].set_title('用户交易频次分布')\n",
    "axes[1, 1].set_xlabel('交易次数')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
