   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. 模型创建"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 定义数据库模式\n",
    "database_schema = {\n",
    "    'users': {\n",
    "        'user_id': 'categorical',\n",
    "        'age': 'numerical',\n",
    "        'gender': 'categorical',\n",
    "        'city': 'categorical'\n",
    "    },\n",
    "    'items': {\n",
    "        'item_id': 'categorical',\n",
    "        'category': 'categorical',\n",
    "        'price': 'numerical',\n",
    "        'brand': 'categorical'\n",
    "    },\n",
    "    'transactions': {\n",
    "        'user_id': 'categorical',\n",
    "        'item_id': 'categorical',\n",
    "        'timestamp': 'time',\n",
    "        'amount': 'numerical',\n",
    "        'rating': 'numerical'\n",
    "    }\n",
    "}\n",
    "\n",
    "# 创建数据库和图\n",
    "database = MockDatabase()\n",
    "database.tables['users'] = users_df\n",
    "database.tables['items'] = items_df\n",
    "database.tables['transactions'] = transactions_df\n",
    "\n",
    "converter = MockGraphConverter()\n",
    "graph = converter.convert(database)\n",
    "\n",
    "print(f\"创建的图: {graph}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 创建模型\n",
    "config = KumoRFMConfig(\n",
    "    hidden_dim=128,\n",
    "    num_layers=2,\n",
    "    num_heads=4,\n",
    "    max_neighbors=50,\n",
    "    num_hops=2,\n",
    "    dropout_rate=0.1\n",
    ")\n",
    "\n",
    "model = KumoRFM(config, database_schema)\n",
    "\n",
    "# 计算模型参数量\n",
    "total_params = sum(p.numel() for p in model.parameters())\n",
    "trainable_params = sum(p.numel() for p in model.parameters() if p.requires_grad)\n",
    "\n",
    "print(f\"模型参数量: {total_params:,}\")\n",
    "print(f\"可训练参数量: {trainable_params:,}\")\n",
    "\n",
    "# 创建预测器\n",
    "predictor = KumoRFMPredictor(model, config)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. 基本预测"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 预测单个用户的未来购买金额\n",
    "target_user = ('users', 0)\n",
    "prediction_time = datetime.now()\n",
    "\n",
    "# 定义任务：预测未来7天的购买金额\n",
    "task_config = TaskConfig(\n",
    "    task_type='regression',\n",
    "    target_column='amount',\n",
    "    aggregation='sum',\n",
    "    time_window_start=-7,\n",
    "    time_window_end=0\n",
    ")\n",
    "\n",
    "# 执行预测\n",
    "result = predictor.predict(\n",
    "    graph,\n",
    "    target_user,\n",
    "    prediction_time,\n",
    "    task_config,\n",
    "    num_context=5\n",
    ")\n",
    "\n",
    "print(f\"预测结果:\")\n",
    "print(f\"  用户ID: {target_user[1]}\")\n",
    "print(f\"  预测金额: ¥{result['predicted_value']:.2f}\")\n",
    "print(f\"  使用的上下文数量: {result['num_context_used']}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 批量预测多个用户\n",
    "user_ids = list(range(10))\n",
    "entities = [('users', uid) for uid in user_ids]\n",
    "\n",
    "batch_results = predictor.batch_predict(\n",
    "    graph,\n",
    "    entities,\n",
    "    prediction_time,\n",
    "    task_config,\n",
    "    batch_size=5\n",
    ")\n",
    "\n",
    "# 可视化预测结果\n",
    "predictions = [r['predicted_value'] for r in batch_results]\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "plt.bar(user_ids, predictions)\n",
    "plt.xlabel('用户ID')\n",
    "plt.ylabel('预测金额 (¥)')\n",
    "plt.title('用户未来7天购买金额预测')\n",
    "plt.show()\n",
    "\n",
    "# 显示统计信息\n",
    "print(f\"平均预测金额: ¥{np.mean(predictions):.2f}\")\n",
    "print(f\"最高预测金额: ¥{np.max(predictions):.2f} (用户 {user_ids[np.argmax(predictions)]})\")\n",
    "print(f\"最低预测金额: ¥{np.min(predictions):.2f} (用户 {user_ids[np.argmin(predictions)]})\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. PQL查询"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 使用PQL进行复杂查询\n",
    "from pql.parser import PQLBuilder\n",
    "\n",
    "# 构建查询：预测高价值用户\n",
    "pql_builder = PQLBuilder()\n",
    "pql_query = pql_builder \\\n",
    "    .predict('amount', 'sum', (-30, 0)) \\\n",
    "    .for_each('users', 'user_id', list(range(5))) \\\n",
    "    .build()\n",
    "\n",
    "print(\"PQL查询结构:\")\n",
    "print(f\"  目标列: {pql_query.target_column}\")\n",
    "print(f\"  聚合方式: {pql_query.aggregation}\")\n",
    "print(f\"  时间窗口: {pql_query.time_window}\")\n",
    "print(f\"  实体: {pql_query.entity_table}.{pql_query.entity_column}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 执行PQL查询（使用字符串形式）\n",
    "pql_string = \"\"\"\n",
    "PREDICT SUM(amount, -30, 0) > 500\n",
    "FOR EACH user_id IN (0, 1, 2, 3, 4)\n",
    "\"\"\"\n",
    "\n",
    "pql_results = predictor.predict_from_pql(\n",
    "    database,\n",
    "    graph,\n",
    "    pql_string\n",
    ")\n",
    "\n",
    "# 显示结果\n",
    "print(\"\\nPQL查询结果:\")\n",
    "for user_id, result in pql_results.items():\n",
    "    if user_id != '_aggregated':\n",
    "        value = result.get('predicted_value', 0)\n",
    "        print(f\"  用户 {user_id}: ¥{value:.2f} {'✓' if value > 500 else '✗'}\")"
   ]
  },
  {
   "cell_type": "markdown",
