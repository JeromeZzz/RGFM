   "source": [
    "## 6. 模型微调"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 为特定任务微调模型\n",
    "from training.finetune import KumoRFMFinetuner\n",
    "\n",
    "# 创建评分预测任务\n",
    "rating_task_config = TaskConfig(\n",
    "    task_type='regression',\n",
    "    target_column='rating',\n",
    "    aggregation='mean'\n",
    ")\n",
    "\n",
    "# 创建微调器\n",
    "finetuner = KumoRFMFinetuner(model, config, rating_task_config)\n",
    "\n",
    "# 冻结骨干网络\n",
    "finetuner.freeze_backbone(freeze_relgt=True, freeze_encoders=True)\n",
    "\n",
    "print(\"微调配置:\")\n",
    "print(f\"  任务类型: {rating_task_config.task_type}\")\n",
    "print(f\"  目标列: {rating_task_config.target_column}\")\n",
    "print(f\"  冻结层: {finetuner.freeze_layers}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. 高级功能"
   ]
  },
  {
   "cell_type": "code",
